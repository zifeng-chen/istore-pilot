#!/bin/sh /etc/rc.common
# iStoreOS Agent 服务脚本（procd 托管）

USE_PROCD=1
START=99
STOP=10

PROG=/usr/lib/istore-agent/run.py
PY=/usr/bin/python3

start_service() {
	procd_open_instance
	procd_set_param command "$PY" -u "$PROG"
	procd_set_param env PYTHONUNBUFFERED=1
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits core="0 0"
	procd_close_instance
}

reload_service() {
	stop
	start
}
