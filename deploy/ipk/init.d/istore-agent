#!/bin/sh /etc/rc.common
# 路由管家 Agent：由 procd 托管，随开机自启，进程挂了自动拉起。
#
# 配置在 /etc/config/istore-agent（LuCI 页面可改），这里读出来用环境变量传给进程。
# 之所以不让进程自己读 uci：Python 侧不需要依赖 uci 命令行，也让「本地直接跑 run.py」
# 和「路由器上跑」走同一套逻辑。

USE_PROCD=1
START=99
STOP=10

PROG=/usr/lib/istore-agent/run.py
PY=/usr/bin/python3

start_service() {
	local enabled port bind
	config_load istore-agent
	config_get_bool enabled main enabled 1
	config_get port main port 8443
	config_get bind main bind 0.0.0.0

	[ "$enabled" = "1" ] || {
		logger -t istore-agent "已在 LuCI 中禁用，跳过启动"
		return 0
	}

	[ -x "$PY" ] || {
		logger -t istore-agent "找不到 $PY，请先安装 python3"
		return 1
	}

	procd_open_instance
	procd_set_param command "$PY" -u "$PROG"
	# env 必须**一次传完**：procd_set_param env 是按类型的对象覆盖，
	# 连续写三行 procod_set_param env 只有最后一行生效（HOST 留下、PORT 丢），
	# 表现为「在 LuCI 改端口没反应」——排查了很久才发现是这一行的事。
	procd_set_param env \
		PYTHONUNBUFFERED=1 \
		ISTORE_AGENT_PORT="$port" \
		ISTORE_AGENT_HOST="$bind"
	# 崩溃后 5 秒重试，1 小时内最多重启 3600 次——正常不会触发上限，
	# 但配置写错导致立刻退出时不会疯狂 fork
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits core="0 0"
	procd_close_instance
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger "istore-agent"
}
