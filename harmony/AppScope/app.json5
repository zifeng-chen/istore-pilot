{
  "app": {
    "bundleName": "com.chaof.istoreos",
    "vendor": "chaof",
    "versionCode": 25,
    "versionName": "0.1.2",
    "icon": "$media:app_icon",
    "label": "$string:app_name"
    // minAPIVersion / targetAPIVersion / apiReleaseType 故意不写：
    // 这三个值由 build-profile.json5 的 compatibleSdkVersion 推导后自动写入产物。
    // 手写在这里一旦和 compatibleSdkVersion 不一致，构建会直接报 conflict。
  }
}
