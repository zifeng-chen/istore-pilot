        return 'M12 3.6 C15 3.6 17.77 5.2 19.27 7.8 C20.78 10.4 20.78 13.6 19.27 16.2 C17.77 18.8 15 20.4 12 20.4 C9 20.4 6.23 18.8 4.73 16.2 C3.22 13.6 3.22 10.4 4.73 7.8 C6.23 5.2 9 3.6 12 3.6';
    }
  }

  /** 需要实心填充的部分（色盘上的孔、信息图标上的点）。返回空串表示没有 */
  static fill(kind: string): string {
    if (kind === Glyph.PALETTE) {
      return 'M8.6 7.9 C9.43 7.9 10.1 8.57 10.1 9.4 C10.1 10.23 9.43 10.9 8.6 10.9 C7.77 10.9 7.1 10.23 7.1 9.4 C7.1 8.57 7.77 7.9 8.6 7.9 M14.6 7.1 C15.43 7.1 16.1 7.77 16.1 8.6 C16.1 9.43 15.43 10.1 14.6 10.1 C13.77 10.1 13.1 9.43 13.1 8.6 C13.1 7.77 13.77 7.1 14.6 7.1 M16.2 12.9 C17.03 12.9 17.7 13.57 17.7 14.4 C17.7 15.23 17.03 15.9 16.2 15.9 C15.37 15.9 14.7 15.23 14.7 14.4 C14.7 13.57 15.37 12.9 16.2 12.9 M10.2 14.3 C11.03 14.3 11.7 14.97 11.7 15.8 C11.7 16.63 11.03 17.3 10.2 17.3 C9.37 17.3 8.7 16.63 8.7 15.8 C8.7 14.97 9.37 14.3 10.2 14.3';
    }
    if (kind === Glyph.INFO) {
      return 'M12 6.9 C12.46 6.9 12.89 7.15 13.13 7.55 C13.36 7.95 13.36 8.45 13.13 8.85 C12.89 9.25 12.46 9.5 12 9.5 C11.54 9.5 11.11 9.25 10.87 8.85 C10.64 8.45 10.64 7.95 10.87 7.55 C11.11 7.15 11.54 6.9 12 6.9';
    }
    return '';
  }
}
