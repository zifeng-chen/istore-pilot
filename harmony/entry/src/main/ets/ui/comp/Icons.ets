  static readonly LINK: string = 'link';
  static readonly GLOBE: string = 'globe';
  static readonly PALETTE: string = 'palette';
  static readonly BOX: string = 'box';
  static readonly SHIELD: string = 'shield';
  static readonly INFO: string = 'info';
  static readonly KEY: string = 'key';
  static readonly REFRESH: string = 'refresh';
  static readonly UPLOAD: string = 'upload';
  static readonly CLOCK: string = 'clock';
  static readonly CHIP: string = 'chip';
  static readonly POWER: string = 'power';
  static readonly LIST: string = 'list';
  static readonly BOLT: string = 'bolt';
  static readonly CHEVRON: string = 'chevron';
  /** 左向箭头（返回）。用路径画而不是 Text('‹')：系统字体里不一定有这个字符，
   *  渲染出来可能是个小点，返回按钮就「消失」了 */
  static readonly CHEVRON_LEFT: string = 'chevron_left';
  /** 上下双箭头（网络入口那种「上传/下载」的语义） */
  static readonly SWAP: string = 'swap';
  static readonly CHECK: string = 'check';
  static readonly CLOSE: string = 'close';

  /** 只描边的部分 */
  static stroke(kind: string): string {
    switch (kind) {
      case Glyph.GLOBE:
        return 'M3.6 12 L20.4 12 M12 3.6 C15 3.6 17.77 5.2 19.27 7.8 C20.78 10.4 20.78 13.6 19.27 16.2 C17.77 18.8 15 20.4 12 20.4 C9 20.4 6.23 18.8 4.73 16.2 C3.22 13.6 3.22 10.4 4.73 7.8 C6.23 5.2 9 3.6 12 3.6 M6.2 12 C6.2 7.36 8.8 3.6 12 3.6 C15.2 3.6 17.8 7.36 17.8 12 C17.8 16.64 15.2 20.4 12 20.4 C8.8 20.4 6.2 16.64 6.2 12';
      case Glyph.LINK:
        // 两个节点 + 中间连线：比画链条更清楚
        return 'M8.1 12 L15.9 12 M5.5 9.4 C6.43 9.4 7.29 9.9 7.75 10.7 C8.22 11.5 8.22 12.5 7.75 13.3 C7.29 14.1 6.43 14.6 5.5 14.6 C4.57 14.6 3.71 14.1 3.25 13.3 C2.78 12.5 2.78 11.5 3.25 10.7 C3.71 9.9 4.57 9.4 5.5 9.4 M18.5 9.4 C19.43 9.4 20.29 9.9 20.75 10.7 C21.22 11.5 21.22 12.5 20.75 13.3 C20.29 14.1 19.43 14.6 18.5 14.6 C17.57 14.6 16.71 14.1 16.25 13.3 C15.78 12.5 15.78 11.5 16.25 10.7 C16.71 9.9 17.57 9.4 18.5 9.4';
      case Glyph.PALETTE:
        return 'M12 3.6 C15 3.6 17.77 5.2 19.27 7.8 C20.78 10.4 20.78 13.6 19.27 16.2 C17.77 18.8 15 20.4 12 20.4 C9 20.4 6.23 18.8 4.73 16.2 C3.22 13.6 3.22 10.4 4.73 7.8 C6.23 5.2 9 3.6 12 3.6';
      case Glyph.BOX:
        return 'M12 3.4 L20 7.6 L20 16.4 L12 20.6 L4 16.4 L4 7.6 Z M4 7.6 L12 11.8 L20 7.6 M12 11.8 L12 20.6';
      case Glyph.SHIELD:
        return 'M12 3.2 L19.6 6.4 L19.6 12.2 C19.6 16.4 16.4 19.4 12 20.8 C7.6 19.4 4.4 16.4 4.4 12.2 L4.4 6.4 Z';
      case Glyph.INFO:
        return 'M12 3.6 C15 3.6 17.77 5.2 19.27 7.8 C20.78 10.4 20.78 13.6 19.27 16.2 C17.77 18.8 15 20.4 12 20.4 C9 20.4 6.23 18.8 4.73 16.2 C3.22 13.6 3.22 10.4 4.73 7.8 C6.23 5.2 9 3.6 12 3.6 M12 11.2 L12 16.2';
      case Glyph.KEY:
        return 'M8.4 7.8 C9.9 7.8 11.29 8.6 12.04 9.9 C12.79 11.2 12.79 12.8 12.04 14.1 C11.29 15.4 9.9 16.2 8.4 16.2 C6.9 16.2 5.51 15.4 4.76 14.1 C4.01 12.8 4.01 11.2 4.76 9.9 C5.51 8.6 6.9 7.8 8.4 7.8 M12.6 12 L20.2 12 M17.4 12 L17.4 15.4 M20.2 12 L20.2 14.6';
      case Glyph.REFRESH:
        return 'M17 6 C19.52 8.1 20.45 11.56 19.33 14.65 C18.21 17.73 15.28 19.79 12 19.79 C8.72 19.79 5.79 17.73 4.67 14.65 C3.55 11.56 4.48 8.1 7 6 M16.6 3.4 L20.4 5.6 L16.2 7.6';
      case Glyph.UPLOAD:
        return 'M12 17.4 L12 4.6 M7.6 9 L12 4.4 L16.4 9 M4.6 19.6 L19.4 19.6';
      case Glyph.CLOCK:
        return 'M12 3.6 C15 3.6 17.77 5.2 19.27 7.8 C20.78 10.4 20.78 13.6 19.27 16.2 C17.77 18.8 15 20.4 12 20.4 C9 20.4 6.23 18.8 4.73 16.2 C3.22 13.6 3.22 10.4 4.73 7.8 C6.23 5.2 9 3.6 12 3.6 M12 7.4 L12 12.4 L15.4 14.2';
      case Glyph.CHIP:
        return 'M8.2 6.2 L15.8 6.2 C16.9 6.2 17.8 7.1 17.8 8.2 L17.8 15.8 C17.8 16.9 16.9 17.8 15.8 17.8 L8.2 17.8 C7.1 17.8 6.2 16.9 6.2 15.8 L6.2 8.2 C6.2 7.1 7.1 6.2 8.2 6.2 Z M11 10 L13 10 C13.55 10 14 10.45 14 11 L14 13 C14 13.55 13.55 14 13 14 L11 14 C10.45 14 10 13.55 10 13 L10 11 C10 10.45 10.45 10 11 10 Z M8.2 2.8 L8.2 6.2 M8.2 17.8 L8.2 21.2 M2.8 8.2 L6.2 8.2 M17.8 8.2 L21.2 8.2 M12 2.8 L12 6.2 M12 17.8 L12 21.2 M2.8 12 L6.2 12 M17.8 12 L21.2 12 M15.8 2.8 L15.8 6.2 M15.8 17.8 L15.8 21.2 M2.8 15.8 L6.2 15.8 M17.8 15.8 L21.2 15.8';
      case Glyph.POWER:
        return 'M15.6 6.37 C18.42 8 19.8 11.32 18.95 14.47 C18.11 17.62 15.26 19.81 12 19.81 C8.74 19.81 5.89 17.62 5.05 14.47 C4.2 11.32 5.58 8 8.4 6.37 M12 2.8 L12 11.4';
      case Glyph.LIST:
        return 'M4 7 L20 7 M4 12 L20 12 M4 17 L20 17';
      case Glyph.BOLT:
        return 'M13.4 2.6 L5.4 13.6 L11.2 13.6 L9.8 21.4 L18.4 10 L12.4 10 Z';
      case Glyph.CHEVRON:
        return 'M8.5 5.5 L14.5 11 L8.5 16.5';
      case Glyph.CHEVRON_LEFT:
        return 'M15.5 5.5 L9.5 11 L15.5 16.5';
      case Glyph.SWAP:
        return 'M8 4.6 L8 18.4 M8 4.6 L5 7.6 M8 4.6 L11 7.6 M16 19.4 L16 5.6 M16 19.4 L13 16.4 M16 19.4 L19 16.4';
      case Glyph.CHECK:
        return 'M4.5 11.5 L9 16 L17.5 6.5';
      case Glyph.CLOSE:
        return 'M6.6 6.6 L17.4 17.4 M17.4 6.6 L6.6 17.4';
