<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 基础主题：所有限定符版本都继承它，只在各自目录里覆盖个别项。
         注意 values-night 里同名 style 是整体替换而不是合并，
         所以绝不能在 night 里重复定义完整主题，否则丢项。 -->
    <style name="Theme.IStore.Base" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_dim</item>
        <item name="colorOnPrimaryContainer">@color/on_primary</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_hi</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorError">@color/danger</item>
        <item name="android:colorBackground">@color/app_bg</item>
        <item name="android:windowBackground">@color/app_bg</item>
        <item name="android:statusBarColor">@color/app_bg</item>
        <item name="android:navigationBarColor">@color/app_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <!-- iOS 风格的圆润观感：系统字体 + 轻字重，避免 Material 默认的粗黑 -->
        <item name="android:fontFamily">sans-serif</item>
        <item name="materialAlertDialogTheme">@style/DialogTheme</item>
    </style>

    <!-- 日间：状态栏图标用深色 -->
    <style name="AppTheme" parent="Theme.IStore.Base">
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- 对话框也用大圆角，跟卡片一致 -->
    <style name="DialogTheme" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/DialogShape</item>
    </style>

    <style name="DialogShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <!-- 自定义底部弹层：透明窗口 + 从底部滑入，圆角与留白全部由代码画 -->
    <style name="SheetDialog" parent="Theme.AppCompat.DayNight.Dialog">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>

    <style name="SheetAnim">
        <item name="android:windowEnterAnimation">@anim/sheet_in</item>
        <item name="android:windowExitAnimation">@anim/sheet_out</item>
    </style>

    <!-- 统一卡片：大圆角（iOS inset grouped 观感）、无阴影、背景用 surface -->
    <style name="Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardPreventCornerOverlap">true</item>
    </style>

    <style name="CardInsist" parent="Card">
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="rippleColor">@color/ripple</item>
    </style>

    <!-- 分组标题：iOS 用小号大写灰字，不抢注意力 -->
    <style name="SectionTitle">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="ValueText">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="LabelText">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="BigNumber">
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- 底部标签栏文字：iOS 用 10pt 左右，比 Material 默认的 12sp 小一档，
         字号小一点图标和文字才不会挤在一起 -->
    <style name="NavLabel" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">10.5sp</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

</resources>
