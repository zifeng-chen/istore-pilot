<?xml version="1.0" encoding="utf-8"?>
<!--
  路由器页面是 http 明文，Android 9+ 默认禁止。
  这里放开明文，但只信任系统证书（以后如果上自签 HTTPS，需要加 user 证书）。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <!-- 只信系统证书。user 证书等于让「谁装了 CA 谁就能中间人」，
             而这里传的是登录口令和令牌 -->
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
