# 统一换行符为 LF —— 本仓库要在 Windows / macOS 之间来回构建，
# 脚本一旦被转成 CRLF，在 macOS 上会报 "bad interpreter"。
* text=auto eol=lf

# 明确按二进制处理，不参与换行转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.gz   binary
*.zip  binary
*.hap  binary
*.apk  binary
*.ipk  binary
*.jar  binary
*.keystore binary
*.jks  binary
*.ttf  binary
*.otf  binary

# shell 脚本必须 LF
*.sh   text eol=lf
*.ets  text eol=lf
*.swift text eol=lf

# Windows 批处理保留 CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
